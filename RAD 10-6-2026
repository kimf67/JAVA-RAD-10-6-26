import java.util.Scanner;

public class DiagnosticActivity {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Enter a number: ");
        int n = input.nextInt();

        for (int i = 1; i <= 30; i++) {
            if (i == 7) {
                continue;            
            }
            if (i % 30 == 0) {       
                System.out.println(i);
            }
            if (i == 30) {
                break;         
            }
        }
        input.close();
    }
}

